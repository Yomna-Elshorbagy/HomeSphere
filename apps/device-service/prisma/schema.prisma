//Prisma schema file for the Device Service

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-device"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id         String   @id @default(uuid())
  name       String
  type       String   // LIGHT, THERMOSTAT, SENSOR, etc.
  homeId     String   // Soft relation to Home in home_db
  roomId     String?  // Soft relation to Room in home_db
  macAddress String   @unique
  mqttTopic  String?
  status     String   @default("OFFLINE")
  metadata   String?  // JSON string for device-specific config (brightness, temp, etc.)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([homeId])
  @@index([roomId])
}
