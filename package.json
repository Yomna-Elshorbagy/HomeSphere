{
  "name": "homeflow-backend",
  "version": "1.0.0",
  "description": "HomeFlow Backend Monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:auth": "npm run dev --workspace=@homeflow/auth-service",
    "db:migrate:auth": "npm run db:migrate --workspace=@homeflow/auth-service",
    "dev:home": "npm run dev --workspace=@homeflow/home-service",
    "db:migrate:home": "npm run db:migrate --workspace=@homeflow/home-service",
    "dev:device": "npm run dev --workspace=@homeflow/device-service",
    "db:migrate:device": "npm run db:migrate --workspace=@homeflow/device-service",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5"
  }
}
